# Neon PostgreSQL runtime connection. These variables are required in production.
SQL_HOST="your-neon-pooled-host"
SQL_USER="your-neon-runtime-role"
SQL_PASSWORD="your-neon-runtime-password"
SQL_DB_NAME="your-neon-database"

# Optional direct connection for Drizzle Kit schema administration.
# If SQL_ADMIN_HOST is omitted, drizzle.config.ts falls back to SQL_HOST.
SQL_ADMIN_HOST="your-neon-direct-host"
SQL_ADMIN_USER="your-neon-admin-role"
SQL_ADMIN_PASSWORD="your-neon-admin-password"

# Firebase Admin credentials.
# Configure this to the mounted JSON path when using a Render Secret File.
# Never commit firebase-service-account.json or its private key.
GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/firebase-service-account.json"

# Server mode and listen port.
# Use "development" locally and "production" on Render.
# Render supplies PORT; it may be omitted for local development.
NODE_ENV="development"
PORT="3000"
