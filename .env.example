# Runtime PostgreSQL connection.
# Use the pooled Neon hostname for SQL_HOST.
SQL_HOST="your-pooled-neon-host"
SQL_USER="your-neon-role"
SQL_PASSWORD="your-neon-password"
SQL_DB_NAME="your-neon-database"

# Drizzle Kit schema administration connection.
# Use the direct Neon hostname when it differs from the pooled hostname.
# If omitted, Drizzle Kit falls back to SQL_HOST.
SQL_ADMIN_HOST="your-direct-neon-host"
SQL_ADMIN_USER="your-neon-admin-role"
SQL_ADMIN_PASSWORD="your-neon-admin-password"

NODE_ENV=development

# Used by the existing AI Studio integration, if applicable.
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="https://your-production-domain"
